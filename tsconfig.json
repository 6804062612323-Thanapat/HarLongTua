{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noImplicitOverride": true, "noUnusedLocals": true,
    "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["shared", "server", "client/src", "tests", "netlify"]
}
